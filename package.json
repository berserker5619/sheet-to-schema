{
  "name": "sheet-to-schema",
  "version": "1.0.0-rc.3",
  "description": "Turn spreadsheet rows into records that fit a schema you already have. The main entry is browser-safe with no runtime dependencies; sheet-to-schema/node reads files and serves HTTP.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit && eslint . && node scripts/check-control-chars.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:timezones": "node scripts/check-timezones.mjs",
    "check:consumer": "node scripts/verify-consumer.mjs",
    "regenerate:fixtures": "node test/fixtures/real-world/generate-fixtures.mjs"
  },
  "peerDependencies": {
    "busboy": "^1.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "busboy": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^6.0.3",
    "busboy": "1.6.0",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "jest": "^30.0.0",
    "jszip": "^3.10.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.14",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1"
  },
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berserker5619/sheet-to-schema.git"
  },
  "homepage": "https://github.com/berserker5619/sheet-to-schema#readme",
  "bugs": {
    "url": "https://github.com/berserker5619/sheet-to-schema/issues"
  },
  "author": "Nizamudeen"
}
