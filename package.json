{
  "name": "sheet-to-schema",
  "version": "1.3.0",
  "description": "Turn spreadsheet rows into records that fit a schema you already have. The main entry is browser-safe with no runtime dependencies; sheet-to-schema/node reads files and uploads as a stream.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit && eslint . && node scripts/check-control-chars.mjs && node scripts/check-readme-links.mjs && node scripts/check-release-tags.mjs",
    "check:bundle": "node scripts/check-bundle.mjs && node scripts/check-bundle-selftest.mjs && node scripts/check-removed-api.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:timezones": "node scripts/check-timezones.mjs",
    "check:consumer": "node scripts/verify-consumer.mjs",
    "check:release": "node scripts/check-release-tags.mjs",
    "regenerate:fixtures": "node test/fixtures/real-world/generate-fixtures.mjs",
    "regenerate:parity-fixtures": "node test/fixtures/parity/generate-parity-fixtures.mjs",
    "check:browser-runtime": "node scripts/check-browser-runtime.mjs",
    "check:browsers": "node scripts/check-browsers.mjs"
  },
  "peerDependencies": {
    "busboy": "^1.6.0",
    "exceljs": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "busboy": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/busboy": "^1.5.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "busboy": "1.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "exceljs": "4.4.0",
    "globals": "^17.12.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jszip": "^3.10.2",
    "playwright": "^1.64.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.14",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berserker5619/sheet-to-schema.git"
  },
  "homepage": "https://github.com/berserker5619/sheet-to-schema#readme",
  "bugs": {
    "url": "https://github.com/berserker5619/sheet-to-schema/issues"
  },
  "author": "Nizamudeen"
}
